{
  "name": "kids-game",
  "version": "0.6.56",
  "private": true,
  "description": "Kids block-world game: web prototype wrapped with Capacitor for Android",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test scripts/tests/*.test.mjs",
    "test:quick": "node scripts/test-quick.mjs",
    "android:sync": "npx cap sync android",
    "capacitor:sync:after": "node -e \"const fs=require('fs'),s='www/app-icon/android-res',d='android/app/src/main/res';if(fs.existsSync(s)&&fs.existsSync(d)){fs.cpSync(s,d,{recursive:true});fs.rmSync('android/app/src/main/assets/public/app-icon',{recursive:true,force:true});console.log('App icon installed from www/app-icon')}\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "eslint": "^10.14.0",
    "playwright": "^1.64.1",
    "three": "^0.160.0"
  }
}
